    "@size-limit/file": "14.2.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
