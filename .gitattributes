# Normalise line endings in the repository; check out with LF everywhere so
# hashes, snapshots and golden files are identical on Windows and Linux.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# docker build's output, captured byte for byte (engine/tests/test_sandbox_image.py).
engine/tests/data/docker_build/** -text

*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.woff2 binary
*.db binary

# Generated by @repro/synth (`pnpm fixtures`); collapsed in GitHub diffs.
apps/web/fixtures/*.jsonl linguist-generated=true
